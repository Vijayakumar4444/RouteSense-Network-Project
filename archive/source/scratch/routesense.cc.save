
#include "ns3/aodv-module.h"
#include "ns3/applications-module.h"
#include "ns3/core-module.h"
#include "ns3/flow-monitor-module.h"
#include "ns3/internet-module.h"
#include "ns3/mobility-module.h"
#include "ns3/network-module.h"
#include "ns3/wifi-module.h"

#include <iostream>
#include <iomanip>

using namespace ns3;

int main(int argc, char *argv[])
{
    double simulationTime = 30.0;
    double packetInterval = 0.5;
    bool crossTraffic = false;

    CommandLine cmd(__FILE__);
    cmd.AddValue("simulationTime", "Simulation duration in seconds",
                 simulationTime);
    cmd.AddValue("packetInterval", "Time between UDP packets in seconds",
                 packetInterval);
    cmd.AddValue("crossTraffic", "Enable additional traffic flows",
                 crossTraffic);
    cmd.Parse(argc, argv);

    if (simulationTime <= 4.0 || packetInterval <= 0.0)
    {
        std::cerr << "Invalid simulationTime or packetInterval."
                  << std::endl;
        return 1;
    }

    const uint32_t nodeCount = 12;
    const double maxRange = 100.0;

    NodeContainer nodes;
    nodes.Create(nodeCount);

    // Wireless network configuration
    YansWifiChannelHelper channel;
    channel.SetPropagationDelay(
        "ns3::ConstantSpeedPropagationDelayModel");
    channel.AddPropagationLoss(
        "ns3::RangePropagationLossModel",
        "MaxRange", DoubleValue(maxRange));

    YansWifiPhyHelper phy;
    phy.SetChannel(channel.Create());

    WifiHelper wifi;
    wifi.SetStandard(WIFI_STANDARD_80211b);
    wifi.SetRemoteStationManager(
        "ns3::ConstantRateWifiManager",
        "DataMode", StringValue("DsssRate11Mbps"),
        "ControlMode", StringValue("DsssRate1Mbps"));

    WifiMacHelper mac;
    mac.SetType("ns3::AdhocWifiMac");

    NetDeviceContainer devices = wifi.Install(phy, mac, nodes);

    // Node positions: stationary for Phase 1
    MobilityHelper mobility;
    mobility.SetMobilityModel(
        "ns3::ConstantPositionMobilityModel");
    mobility.Install(nodes);

    Vector positions[nodeCount] = {
        Vector(0, 0, 0),
        Vector(80, 0, 0),
        Vector(160, 0, 0),
        Vector(240, 0, 0),
        Vector(320, 0, 0),
        Vector(400, 0, 0),
        Vector(80, 50, 0),
        Vector(160, 50, 0),
        Vector(240, 50, 0),
        Vector(320, 50, 0),
        Vector(160, -50, 0),
        Vector(240, -50, 0)
    };

    for (uint32_t i = 0; i < nodeCount; ++i)
    {
        Ptr<ConstantPositionMobilityModel> position =
            nodes.Get(i)->GetObject<ConstantPositionMobilityModel>();
        position->SetPosition(positions[i]);
    }

    // AODV is the conventional routing baseline
    AodvHelper aodv;
    InternetStackHelper internet;
    internet.SetRoutingHelper(aodv);
    internet.Install(nodes);

    Ipv4AddressHelper address;
    address.SetBase("10.1.1.0", "255.255.255.0");
    Ipv4InterfaceContainer interfaces = address.Assign(devices);

    // Receivers: node 5 is the main destination
    const uint16_t mainPort = 9;
    const uint16_t secondPort = 10;
    const uint16_t thirdPort = 11;

    PacketSinkHelper sinkHelper(
        "ns3::UdpSocketFactory",
        InetSocketAddress(Ipv4Address::GetAny(), mainPort));

    ApplicationContainer mainSink = sinkHelper.Install(nodes.Get(5));
    mainSink.Start(Seconds(0.0));
    mainSink.Stop(Seconds(simulationTime));

    if (crossTraffic)
    {
        PacketSinkHelper sink2(
            "ns3::UdpSocketFactory",
            InetSocketAddress(Ipv4Address::GetAny(), secondPort));

        PacketSinkHelper sink3(
            "ns3::UdpSocketFactory",
            InetSocketAddress(Ipv4Address::GetAny(), thirdPort));

        ApplicationContainer sinkApps2 = sink2.Install(nodes.Get(4));
        ApplicationContainer sinkApps3 = sink3.Install(nodes.Get(1));

        sinkApps2.Start(Seconds(0.0));
        sinkApps2.Stop(Seconds(simulationTime));
        sinkApps3.Start(Seconds(0.0));
        sinkApps3.Stop(Seconds(simulationTime));
    }

    // Main UDP flow: Node 0 -> Node 5
    UdpClientHelper mainClient(interfaces.GetAddress(5), mainPort);
    mainClient.SetAttribute("MaxPackets", UintegerValue(1000000));
    mainClient.SetAttribute("PacketSize", UintegerValue(1024));
    mainClient.SetAttribute("Interval", TimeValue(Seconds(packetInterval)));

    ApplicationContainer mainApp = mainClient.Install(nodes.Get(0));
    mainApp.Start(Seconds(2.0));
    mainApp.Stop(Seconds(simulationTime - 1.0));

    // Optional competing flows for later experiments
    if (crossTraffic)
    {
        UdpClientHelper client2(interfaces.GetAddress(4), secondPort);
        client2.SetAttribute("MaxPackets", UintegerValue(1000000));
        client2.SetAttribute("PacketSize", UintegerValue(1024));
        client2.SetAttribute("Interval", TimeValue(Seconds(packetInterval)));

        ApplicationContainer app2 = client2.Install(nodes.Get(10));
        app2.Start(Seconds(2.0));
        app2.Stop(Seconds(simulationTime - 1.0));

        UdpClientHelper client3(interfaces.GetAddress(1), thirdPort);
        client3.SetAttribute("MaxPackets", UintegerValue(1000000));
        client3.SetAttribute("PacketSize", UintegerValue(1024));
        client3.SetAttribute("Interval", TimeValue(Seconds(packetInterval)));

        ApplicationContainer app3 = client3.Install(nodes.Get(11));
        app3.Start(Seconds(2.0));
        app3.Stop(Seconds(simulationTime - 1.0));
    }

    // Record flow statistics and packet captures
    FlowMonitorHelper flowHelper;
    Ptr<FlowMonitor> monitor = flowHelper.InstallAll();

    phy.EnablePcap("results/baseline/routesense",
                   devices, true);

    std::cout << "\nRouteSense - Phase 1 Baseline\n";
    std::cout << "Nodes: " << nodeCount << '\n';
    std::cout << "Routing: AODV\n";
    std::cout << "Main flow: Node 0 -> Node 5\n";
    std::cout << "Cross traffic: "
              << (crossTraffic ? "Enabled" : "Disabled") << '\n';
    std::cout << "Simulation duration: "
              << simulationTime << " seconds\n\n";

    Simulator::Stop(Seconds(simulationTime));
    Simulator::Run();

    monitor->CheckForLostPackets();

    Ptr<Ipv4FlowClassifier> classifier =
        DynamicCast<Ipv4FlowClassifier>(flowHelper.GetClassifier());

    std::map<FlowId, FlowMonitor::FlowStats> stats =
        monitor->GetFlowStats();

    std::cout << std::fixed << std::setprecision(2);

    for (const auto &entry : stats)
    {
        FlowId id = entry.first;
        const FlowMonitor::FlowStats &flow = entry.second;
        Ipv4FlowClassifier::FiveTuple tuple =
            classifier->FindFlow(id);

        if (flow.txPackets == 0)
        {
            continue;
        }

        double pdr =
            100.0 * flow.rxPackets / flow.txPackets;

        double loss =
            100.0 * (flow.txPackets - flow.rxPackets)
            / flow.txPackets;

        double delayMs = 0.0;
        if (flow.rxPackets > 0)
        {
            delayMs = 1000.0 * flow.delaySum.GetSeconds()
                      / flow.rxPackets;
        }

        double duration =
            (flow.timeLastRxPacket -
             flow.timeFirstTxPacket).GetSeconds();

        double throughputKbps = 0.0;
        if (flow.rxPackets > 0 && duration > 0.0)
        {
            throughputKbps =
                flow.rxBytes * 8.0 / duration / 1000.0;
        }

        std::cout << "Flow " << id << ": "
                  << tuple.sourceAddress << " -> "
                  << tuple.destinationAddress << '\n';
        std::cout << "  TX packets: " << flow.txPackets << '\n';
        std::cout << "  RX packets: " << flow.rxPackets << '\n';
        std::cout << "  Packet Delivery Ratio: "
                  << pdr << "%\n";
        std::cout << "  Packet Loss Ratio: "
                  << loss << "%\n";
        std::cout << "  Throughput: "
                  << throughputKbps << " Kbps\n";
        std::cout << "  Average end-to-end delay: "
                  << delayMs << " ms\n\n";
    }

    monitor->SerializeToXmlFile(
        "results/baseline/routesense-flowmon.xml",
        true, true);

    Simulator::Destroy();
    return 0;
}
